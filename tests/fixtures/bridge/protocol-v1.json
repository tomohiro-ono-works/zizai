{
  "version": "1.0",
  "commands": [
    "app.getStatus",
    "app.logUiEvent",
    "app.windowControl",
    "mouse.coordinateCapture.start",
    "app.openExternal",
    "app.googleAuthLogin",
    "app.googleAuthStatus",
    "app.getSuggestIndex",
    "flow.list",
    "flow.load",
    "flow.save",
    "flow.run",
    "flow.tabClosed",
    "run.cancel",
    "result.getSummary",
    "result.getSchema",
    "result.getPreview",
    "result.getDatavolume",
    "file.pickFile",
    "file.pickFolder",
    "workspace.pickRoot",
    "workspace.getRoot",
    "workspace.setRoot",
    "workspace.list",
    "workspace.stat",
    "workspace.readText",
    "workspace.writeText",
    "workspace.mkdir",
    "workspace.delete",
    "preview.readExcel",
    "preview.readCsv"
  ],
  "events": [
    {"type": "run.log", "correlation": "run_id", "payload": {"run_id": "run-1", "level": "INFO", "message": "started"}},
    {"type": "run.progress", "correlation": "run_id", "payload": {"run_id": "run-1", "stage": "execute", "message": "running"}},
    {"type": "run.completed", "correlation": "run_id", "payload": {"run_id": "run-1"}},
    {"type": "run.failed", "correlation": "run_id", "payload": {"run_id": "run-1", "error": "failed"}},
    {"type": "run.stepStatus", "correlation": "run_id", "payload": {"run_id": "run-1", "step_id": "step-1", "status": "running"}},
    {"type": "mouse.coordinateCapture.preview", "correlation": "capture_id", "payload": {"capture_id": "capture-1", "x": 10, "y": 20}},
    {"type": "mouse.coordinateCapture.selected", "correlation": "capture_id", "payload": {"capture_id": "capture-1", "x": 10, "y": 20}},
    {"type": "mouse.coordinateCapture.cancelled", "correlation": "capture_id", "payload": {"capture_id": "capture-1"}}
  ]
}
